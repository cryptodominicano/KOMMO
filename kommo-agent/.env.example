# --- Client pack ---
CLIENT_ID=aguas-profundas
# Long random string. Webhook URL becomes /webhook/kommo/<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# --- Kommo ---
KOMMO_SUBDOMAIN=infoswecinvestmentscom
KOMMO_LONG_LIVED_TOKEN=
# VERIFIED live: WhatsApp Business API origin = "waba" (undocumented by Kommo).
# Leave blank to accept ALL origins.
KOMMO_WHATSAPP_ORIGIN=waba

# --- LLM: "openai" or "anthropic" ---
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Transcription ---
# "openai" uses the existing OPENAI_API_KEY. Groq needs a new key; unnecessary at this volume.
TRANSCRIBE_PROVIDER=openai
WHISPER_MODEL_OPENAI=gpt-4o-mini-transcribe
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Qdrant ---
QDRANT_URL=http://172.20.0.10:6333
QDRANT_COLLECTION=aguas_profundas_kb
EMBED_MODEL=text-embedding-3-small
RAG_TOP_K=8
